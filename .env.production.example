# Contoh .env untuk SERVER PRODUCTION. Salin menjadi .env di server, lalu isi
# nilai yang ditandai ISI. Jangan pernah commit file .env yang sudah terisi.

APP_NAME="MagangBridge SMK"
APP_ENV=production
# ISI: jalankan "php artisan key:generate" setelah menyalin file ini.
APP_KEY=
APP_DEBUG=false
# ISI: alamat website dengan https, tanpa garis miring di akhir.
APP_URL=https://domain-anda.com

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# ISI: dari hPanel → Databases → MySQL Databases.
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# Cookie login hanya dikirim lewat https.
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# Proxy yang dipercaya (pisahkan koma). Biarkan bawaan kecuali memakai CDN/load balancer.
TRUSTED_PROXIES=127.0.0.1,::1

# ISI: akun email dari hPanel → Emails (lihat DEPLOY.md).
MAIL_MAILER=smtp
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=noreply@domain-anda.com
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@domain-anda.com
MAIL_FROM_NAME="MagangBridge SMK"

# ISI: API key Google Gemini (aistudio.google.com). Aktifkan billing untuk data siswa.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_MODEL_CADANGAN=gemini-3.5-flash
GEMINI_TIMEOUT=25
GEMINI_BATAS_WAKTU=55

# ISI: akun superadmin pertama (php artisan db:seed --force). Gunakan password kuat.
ADMIN_NAME="Admin Sekolah"
ADMIN_EMAIL=admin@magangbridge.com
ADMIN_PASSWORD=

VITE_APP_NAME="${APP_NAME}"
